# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# ---- NextAuth v5 ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here_minimum_32_chars

# Canonical app URL (must match your OAuth app callback base URL)
NEXTAUTH_URL=http://localhost:3000

# ---- Google OAuth ----
# https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# ---- GitHub OAuth ----
# https://github.com/settings/developers → New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# ---- Vercel Postgres / Neon ----
# These are populated automatically when you run: vercel env pull .env.local
# Or copy them from: Vercel Dashboard → Storage → Your DB → .env.local tab
POSTGRES_URL=postgres://user:pass@host.neon.tech/neondb?sslmode=require
POSTGRES_PRISMA_URL=postgres://user:pass@host.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://user:pass@host.neon.tech/neondb?sslmode=require
POSTGRES_USER=your_db_user
POSTGRES_HOST=your_host.neon.tech
POSTGRES_PASSWORD=your_db_password
POSTGRES_DATABASE=neondb
